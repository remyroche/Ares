"""
Causal Feature Engineering Module

Implements causal feature engineering techniques including:
1. Causal denoising using causal relationships
2. Causal adjustment of features
3. Causal imputation of missing values
4. Causal feature transformation

Key Features:
1. Causal denoising using discovered causal relationships
2. Causal feature adjustment based on parent effects
3. Causal imputation using structural equations
4. Causal feature transformation for enhanced prediction
"""

import numpy as np
import pandas as pd
from typing import Dict, List, Tuple, Optional, Any, Union
from sklearn.linear_model import LinearRegression, Ridge
from sklearn.ensemble import RandomForestRegressor
from sklearn.impute import KNNImputer
import warnings

# Import tprint functions
try:
    from src.utils.tprint import tprint_info, tprint_success, tprint_warning, tprint_error
except ImportError:
    # Fallback print functions
    def tprint_info(msg): print(f"[INFO] {msg}")
    def tprint_success(msg): print(f"[SUCCESS] {msg}")
    def tprint_warning(msg): print(f"[WARNING] {msg}")
    def tprint_error(msg): print(f"[ERROR] {msg}")

class CausalFeatureEngineering:
    """
    Causal feature engineering using discovered causal relationships.
    
    Applies causal adjustments, denoising, and transformations to features
    based on their causal relationships for improved model performance.
    """
    
    def __init__(
        self,
        causal_graph: Optional[Dict[str, List[str]]] = None,
        causal_strength: Optional[np.ndarray] = None,
        variable_names: Optional[List[str]] = None,
        denoising_method: str = "ridge",
        imputation_method: str = "causal",
        verbose: bool = True
    ):
        """
        Initialize Causal Feature Engineering.
        
        Args:
            causal_graph: Causal graph from discovery
            causal_strength: Causal strength matrix
            variable_names: Variable names
            denoising_method: Method for causal denoising
            imputation_method: Method for causal imputation
            verbose: Whether to print progress information
        """
        self.verbose = verbose
        self.causal_graph = causal_graph
        self.causal_strength = causal_strength
        self.variable_names = variable_names or []
        self.denoising_method = denoising_method
        self.imputation_method = imputation_method
        
        # Storage for learned models
        self.causal_models_ = {}
        self.causal_adjustments_ = {}
        self.feature_transformations_ = {}
        
    def learn_causal_relationships(self, data: pd.DataFrame) -> Dict[str, Any]:
        """
        Learn causal relationships from data using linear models.
        
        Args:
            data: Input data
            
        Returns:
            Dictionary of learned causal models
        """
        try:
            if self.verbose:
                tprint_info("🧠 Learning Causal Relationships: Starting...")
            
            if self.causal_graph is None:
                # User request: Fast fail, no correlation fallback
                tprint_error("   ❌ No causal graph provided for feature engineering")
                raise ValueError("Causal graph is required for causal feature engineering")
                # Create simple correlation-based graph
                numeric_data = data.select_dtypes(include=[np.number])
                corr_matrix = numeric_data.corr()
                self.causal_graph = {}
                for var in numeric_data.columns:
                    # Find highly correlated variables as potential parents
                    correlations = corr_matrix[var].abs().sort_values(ascending=False)
                    parents = [corr for corr in correlations.index[1:6] if correlations[corr] > 0.3]
                    self.causal_graph[var] = parents
                
                tprint_info(f"   🔗 Created correlation-based graph with {len(self.causal_graph)} variables")
            
            # Learn causal models for each variable
            causal_models = {}
            models_trained = 0
            models_failed = 0
            
            for target_var, parent_vars in self.causal_graph.items():
                if target_var not in data.columns:
                    if self.verbose:
                        tprint_warning(f"   ⚠️ Target variable {target_var} not in data")
                    continue
                
                # Get parent variables that exist in data
                valid_parents = [p for p in parent_vars if p in data.columns]
                
                if len(valid_parents) > 0:
                    if self.verbose:
                        tprint_info(f"   📊 Learning model for {target_var} (parents: {valid_parents})")
                    
                    # Learn causal model
                    if self.denoising_method == "ridge":
                        model = Ridge(alpha=1.0)
                    elif self.denoising_method == "random_forest":
                        model = RandomForestRegressor(n_estimators=50, random_state=42)
                    else:
                        model = LinearRegression()
                    
                    try:
                        X = data[valid_parents].fillna(data[valid_parents].mean())
                        y = data[target_var].fillna(data[target_var].mean())
                        
                        model.fit(X, y)
                        causal_models[target_var] = {
                            'model': model,
                            'parents': valid_parents,
                            'coefficients': model.coef_ if hasattr(model, 'coef_') else None,
                            'score': model.score(X, y)
                        }
                        
                        models_trained += 1
                        if self.verbose and models_trained <= 50:  # Show more progress
                            tprint_info(f"      ✅ {target_var}: score={model.score(X, y):.4f}")
                            
                    except Exception as e:
                        models_failed += 1
                        if self.verbose:
                            tprint_warning(f"      ❌ {target_var}: {e}")
                else:
                    if self.verbose:
                        tprint_warning(f"   ⚠️ No valid parents for {target_var}")
            
            self.causal_models_ = causal_models
            
            if self.verbose:
                tprint_success(f"✅ Causal relationship learning complete:")
                tprint_info(f"   - Models trained: {models_trained}")
                tprint_info(f"   - Models failed: {models_failed}")
                tprint_info(f"   - Success rate: {models_trained/(models_trained+models_failed)*100:.1f}%")
            
            return causal_models
            
        except Exception as e:
            if self.verbose:
                tprint_error(f"❌ Causal relationship learning failed: {e}")
            raise
            
        except Exception as e:
            if self.verbose:
                tprint_error(f"❌ Causal relationship learning failed: {e}")
            raise
    
    def _add_microstructure_features(self, df: pd.DataFrame) -> pd.DataFrame:
        """
        Derive microstructure proxies from OHLCV data.
        """
        # 1. Flow Imbalance (Intraday Intensity / Money Flow Multiplier)
        # (((C - L) - (H - C)) / (H - L)) * V
        high_low = df['high'] - df['low']
        replace_zero = high_low.replace(0, 1e-9) 
        
        mf_multiplier = ((df['close'] - df['low']) - (df['high'] - df['close'])) / replace_zero
        df['flow_imbalance_proxy'] = mf_multiplier * df['volume']
        
        # [NEW] Imbalance Dynamics (Rate of Change) - Sudden flips are predictive
        df['flow_imbalance_delta'] = df['flow_imbalance_proxy'].diff()
        
        # 2. Buying/Selling Pressure
        df['buying_pressure_proxy'] = (df['close'] - df['low']) / replace_zero
        
        # 3. Liquidity Stress / Range Shock
        # Liquidity Proxy (Amihud)
        vol_replace = df['volume'].replace(0, 1e-9)
        df['illiquidity_proxy'] = (df['high'] - df['low']).abs() / vol_replace
        
        # [NEW] Spread/Range Shock (Rapid widening of range)
        df['range_shock_proxy'] = high_low.diff()
        
        # 4. Execution Pressure
        vol_ma = df['volume'].rolling(20).mean()
        df['execution_pressure_proxy'] = df['volume'] / vol_ma.replace(0, 1e-9)
        
        return df

    def _add_volatility_regimes(self, df: pd.DataFrame) -> pd.DataFrame:
        """
        Condition features on Volatility Regimes.
        """
        # 1. Calculate Volatility
        returns = df['close'].pct_change()
        vol = returns.rolling(48).std() 
        
        # 2. Define Thresholds 
        vol_33 = vol.expanding(min_periods=200).quantile(0.33)
        vol_66 = vol.expanding(min_periods=200).quantile(0.66)
        
        # 3. Create Regime Flags
        is_low_vol = (vol <= vol_33).astype(int)
        is_high_vol = (vol > vol_66).astype(int)
        
        df['regime_vol_low'] = is_low_vol
        df['regime_vol_high'] = is_high_vol
        
        # [NEW] Trend-Vol Coupling
        # Spike in trending low-vol environment is strong
        # Simple trend proxy: Price vs EMA(50)
        ema_50 = df['close'].ewm(span=50).mean()
        trend_strength = (df['close'] - ema_50) / ema_50
        
        df['trend_x_low_vol'] = trend_strength * is_low_vol
        
        # 4. Create Regime-Conditioned Features (Interaction Terms)
        key_signals = ['flow_imbalance_proxy', 'flow_imbalance_delta', 'illiquidity_proxy', 'range_shock_proxy']
        
        for sig in key_signals:
            if sig in df.columns:
                df[f'{sig}_x_high_vol'] = df[sig] * is_high_vol
                df[f'{sig}_x_low_vol'] = df[sig] * is_low_vol
                
        return df

    def _filter_by_information_content(self, df: pd.DataFrame, target_col: str = 'close') -> pd.DataFrame:
        """
        Filter features with low information content (proxy: correlation with price change).
        """
        if df.empty: return df
        
        # Define target for relevance (absolute price change 1-step)
        # We want features that move when price moves
        target = df[target_col].pct_change().abs().fillna(0)
        
        # Calculate correlations
        corrs = df.corrwith(target).abs()
        
        # Threshold: Very low to only remove dead features
        threshold = 0.001 
        keep_cols = corrs[corrs > threshold].index.tolist()
        
        # Always keep OHLCV and criticals
        criticals = ['open', 'high', 'low', 'close', 'volume', 'vwap']
        keep_cols = list(set(keep_cols).union(set(criticals)))
        
        dropped = len(df.columns) - len(keep_cols)
        if dropped > 0:
            if self.verbose:
                 tprint_info(f"   🧹 Quality Discriminator: Dropped {dropped} low-info features (<{threshold})")
                 
        return df[keep_cols]

    def enhance_features(self, df: pd.DataFrame) -> pd.DataFrame:
        """
        Main pipeline for causal features.
        """
        df_enhanced = df.copy()
        
        # 1. Add Micro-Structure Features
        df_enhanced = self._add_microstructure_features(df_enhanced)
        
        # 2. Add Volatility Regimes
        df_enhanced = self._add_volatility_regimes(df_enhanced)
        
        # 3. Quality Filter (NEW)
        df_enhanced = self._filter_by_information_content(df_enhanced) # Standard 'close' used as proxy target
        
        return df_enhanced
    
    def causal_denoise(self, data: pd.DataFrame) -> pd.DataFrame:
        """
        Apply causal denoising to features.
        
        Args:
            data: Input data
            
        Returns:
            Denoised data
        """
        try:
            if self.verbose:
                tprint_info("🔧 Causal Denoising: Starting denoising process...")
            
            if not self.causal_models_:
                if self.verbose:
                    tprint_info("   ⚙️ No causal models available, learning relationships...")
                self.learn_causal_relationships(data)
            
            if not self.causal_models_:
                if self.verbose:
                    tprint_warning("   ⚠️ No causal models available, returning original data")
                return data
            
            denoised_data = data.copy()
            features_denoised = 0
            features_failed = 0
            
            for target_var, model_info in self.causal_models_.items():
                if target_var not in data.columns:
                    if self.verbose:
                        tprint_warning(f"   ⚠️ Target {target_var} not in data")
                    continue
                
                try:
                    if self.verbose and features_denoised < 3:  # Show first few
                        tprint_info(f"   📊 Denoising {target_var}...")
                    
                    model = model_info['model']
                    parents = model_info['parents']
                    
                    # Predict based on parents
                    X_parents = data[parents].fillna(data[parents].mean())
                    predicted = model.predict(X_parents)
                    
                    # Create denoised version (weighted average of actual and predicted)
                    actual = data[target_var].fillna(data[target_var].mean())
                    model_score = model_info['score']
                    
                    # Weight by model performance
                    weight = max(0.0, min(1.0, model_score))
                    denoised = weight * predicted + (1 - weight) * actual
                    
                    denoised_data[f"{target_var}_causal_denoised"] = denoised
                    features_denoised += 1
                    
                    if self.verbose and features_denoised <= 50:  # Show more progress
                        tprint_info(f"      ✅ {target_var}: weight={weight:.3f}, score={model_score:.4f}")
                    
                except Exception as e:
                    features_failed += 1
                    if self.verbose:
                        tprint_warning(f"      ❌ {target_var}: {e}")
            
            if self.verbose:
                tprint_success(f"✅ Causal denoising complete:")
                tprint_info(f"   - Features denoised: {features_denoised}")
                tprint_info(f"   - Features failed: {features_failed}")
                tprint_info(f"   - Success rate: {features_denoised/(features_denoised+features_failed)*100:.1f}%")
            
            return denoised_data
            
        except Exception as e:
            if self.verbose:
                tprint_error(f"❌ Causal denoising failed: {e}")
            return data
    
    def causal_adjustment(self, data: pd.DataFrame) -> pd.DataFrame:
        """
        Apply causal adjustment to remove parent effects.
        
        Args:
            data: Input data
            
        Returns:
            Causally adjusted data
        """
        try:
            if self.verbose:
                tprint_info("⚖️ Applying Causal Adjustment...")
            
            if not self.causal_models_:
                self.learn_causal_relationships(data)
            
            adjusted_data = data.copy()
            
            for target_var, model_info in self.causal_models_.items():
                if target_var not in data.columns:
                    continue
                
                model = model_info['model']
                parents = model_info['parents']
                
                # Calculate parent effects
                X_parents = data[parents].fillna(data[parents].mean())
                parent_effects = model.predict(X_parents)
                
                # Remove parent effects (residualize)
                actual = data[target_var].fillna(data[target_var].mean())
                adjusted = actual - parent_effects
                
                adjusted_data[f"{target_var}_causal_adjusted"] = adjusted
                
                # Store adjustment info
                self.causal_adjustments_[target_var] = {
                    'parent_effects_mean': np.mean(parent_effects),
                    'adjustment_mean': np.mean(adjusted),
                    'adjustment_std': np.std(adjusted)
                }
                
                if self.verbose and len(self.causal_models_) <= 5:
                    tprint_info(f"   - Adjusted {target_var} (parent effects removed)")
            
            if self.verbose:
                n_adjusted = len([col for col in adjusted_data.columns if "_causal_adjusted" in col])
                tprint_success(f"✅ Causal adjustment complete: {n_adjusted} features")
            
            return adjusted_data
            
        except Exception as e:
            if self.verbose:
                tprint_error(f"❌ Causal adjustment failed: {e}")
            return data
    
    def causal_imputation(self, data: pd.DataFrame) -> pd.DataFrame:
        """
        Apply causal imputation for missing values.
        
        Args:
            data: Input data with missing values
            
        Returns:
            Imputed data
        """
        try:
            if self.verbose:
                tprint_info("🔍 Applying Causal Imputation...")
            
            if not self.causal_models_:
                self.learn_causal_relationships(data)
            
            imputed_data = data.copy()
            
            # Count missing values
            missing_counts = data.isnull().sum()
            vars_with_missing = missing_counts[missing_counts > 0].index.tolist()
            
            if self.verbose:
                tprint_info(f"   - Variables with missing values: {len(vars_with_missing)}")
            
            for target_var in vars_with_missing:
                if target_var not in self.causal_models_:
                    continue
                
                model_info = self.causal_models_[target_var]
                model = model_info['model']
                parents = model_info['parents']
                
                # Find missing indices
                missing_mask = data[target_var].isnull()
                
                if missing_mask.sum() == 0:
                    continue
                
                # Use parents to impute
                X_parents = data[parents].fillna(data[parents].mean())
                predicted_values = model.predict(X_parents[missing_mask])
                
                # Impute missing values
                imputed_data.loc[missing_mask, target_var] = predicted_values
                
                if self.verbose and len(vars_with_missing) <= 5:
                    tprint_info(f"   - Imputed {missing_mask.sum()} values for {target_var}")
            
            if self.verbose:
                remaining_missing = imputed_data.isnull().sum().sum()
                tprint_success(f"✅ Causal imputation complete: {remaining_missing} missing values remaining")
            
            return imputed_data
            
        except Exception as e:
            if self.verbose:
                tprint_error(f"❌ Causal imputation failed: {e}")
            return data
    
    def causal_feature_transformation(
        self, 
        data: pd.DataFrame, 
        max_transformations: int = 50,
        min_denoising_weight: float = 0.4,  # Raised from 0.3 per De Prado
        min_r_squared: float = 0.1,
        max_r_squared_cv: float = 0.5,  # Rolling R² CV ≤ 0.5
        min_sign_consistency: float = 0.65,  # Sign consistency ≥ 65%
        correlation_threshold: float = 0.95
    ) -> pd.DataFrame:
        """
        Apply causal feature transformations with smart selection.
        
        Uses multiple filters for efficiency and quality (De Prado aligned):
        1. Denoising weight filter (only transform if weight ≥ threshold)
        2. Causal significance filter (R² ≥ threshold)
        3. Temporal stability filter (R² CV ≤ 0.5, sign consistency ≥ 65%)
        4. Max transformations limit (top N by composite score)
        5. Correlation deduplication (remove |corr| > threshold after)
        
        Future: DSR ≥ 0.9, SPA p-value ≤ 0.05 (requires backtesting returns)
        
        Args:
            data: Input data
            max_transformations: Maximum models to transform
            min_denoising_weight: Minimum denoising weight to include
            min_r_squared: Minimum R² for causal significance
            max_r_squared_cv: Maximum R² coefficient of variation (stability)
            min_sign_consistency: Minimum sign consistency across windows
            correlation_threshold: Remove features with |corr| > this
            
        Returns:
            Transformed data
        """
        try:
            if self.verbose:
                tprint_info("🔄 Applying Causal Feature Transformations (De Prado Filters)...")
            
            if not self.causal_models_:
                self.learn_causal_relationships(data)
            
            transformed_data = data.copy()
            
            # === FILTER 1 & 2 & 3: Denoising Weight + R² + Temporal Stability ===
            qualified_models = []
            stability_rejected = 0
            
            for target_var, model_info in self.causal_models_.items():
                if target_var not in data.columns:
                    continue
                    
                # Get denoising weight (from causal_adjustments_ if available)
                denoising_weight = 0.5  # default
                if hasattr(self, 'causal_adjustments_') and target_var in self.causal_adjustments_:
                    denoising_weight = self.causal_adjustments_[target_var].get('weight', 0.5)
                
                # Get R² (causal significance)
                r_squared = model_info.get('r_squared', 0)
                
                # Basic filters first
                if denoising_weight < min_denoising_weight or r_squared < min_r_squared:
                    continue
                
                # === TEMPORAL STABILITY FILTER ===
                # Compute rolling R² and sign consistency on subwindows
                try:
                    model = model_info['model']
                    parents = model_info['parents']
                    
                    if len(parents) > 0 and target_var in data.columns:
                        X_parents = data[parents].fillna(data[parents].mean())
                        y_target = data[target_var]
                        
                        # Use 5 non-overlapping windows for stability check
                        n_windows = 5
                        window_size = len(data) // n_windows
                        
                        if window_size >= 50:  # Only check if enough data per window
                            r2_scores = []
                            signs = []
                            
                            for w in range(n_windows):
                                start_idx = w * window_size
                                end_idx = start_idx + window_size
                                
                                X_w = X_parents.iloc[start_idx:end_idx]
                                y_w = y_target.iloc[start_idx:end_idx]
                                
                                # Compute R² for this window
                                y_pred = model.predict(X_w)
                                ss_res = ((y_w - y_pred) ** 2).sum()
                                ss_tot = ((y_w - y_w.mean()) ** 2).sum()
                                r2_w = 1 - (ss_res / ss_tot) if ss_tot > 0 else 0
                                r2_scores.append(max(0, r2_w))
                                
                                # Track sign of predictions (for sign consistency)
                                signs.append(np.sign(y_pred.mean()) if len(y_pred) > 0 else 0)
                            
                            # R² CV check
                            r2_mean = np.mean(r2_scores)
                            r2_std = np.std(r2_scores)
                            r2_cv = r2_std / r2_mean if r2_mean > 0 else 1.0
                            
                            # Sign consistency check
                            sign_consistency = sum(1 for s in signs if s == signs[0]) / len(signs)
                            
                            # Reject if unstable
                            if r2_cv > max_r_squared_cv or sign_consistency < min_sign_consistency:
                                stability_rejected += 1
                                continue
                                
                except Exception:
                    pass  # If stability check fails, allow through
                
                # Composite score: 50% R² + 50% denoising weight
                composite_score = 0.5 * r_squared + 0.5 * denoising_weight
                qualified_models.append((target_var, model_info, composite_score))
            
            # === FILTER 4: Top N by Composite Score ===
            qualified_models.sort(key=lambda x: x[2], reverse=True)
            selected_models = qualified_models[:max_transformations]
            
            if self.verbose:
                tprint_info(f"   📊 Models qualified: {len(qualified_models)}/{len(self.causal_models_)}")
                if stability_rejected > 0:
                    tprint_info(f"   ⚠️ Stability filter rejected: {stability_rejected} models (R² CV > {max_r_squared_cv} or sign < {min_sign_consistency})")
                tprint_info(f"   📊 Models selected: {len(selected_models)} (top by composite score)")
            
            # Create causal interaction features
            new_feature_names = []
            for target_var, model_info, score in selected_models:
                parents = model_info['parents']
                
                # Create parent-target interactions (limit to top 2 parents)
                for parent in parents[:2]:
                    if parent in data.columns:
                        interaction_name = f"{target_var}_x_{parent}_causal"
                        interaction = data[target_var] * data[parent]
                        transformed_data[interaction_name] = interaction
                        new_feature_names.append(interaction_name)
                
                # Create causal residual features
                if len(parents) > 0:
                    model = model_info['model']
                    X_parents = data[parents].fillna(data[parents].mean())
                    predicted = model.predict(X_parents)
                    residual = data[target_var] - predicted
                    residual_name = f"{target_var}_causal_residual"
                    transformed_data[residual_name] = residual
                    new_feature_names.append(residual_name)

            # === ENHANCEMENT 5: Sparse Aggregates (Clusters of Events) ===
            # For sparse features (mostly zeros), create rolling sums
            for col in data.columns:
                if 'proxy' in col or 'imbalance' in col:
                    # Check sparsity (if > 50% zeros)
                    is_zero = (data[col].abs() < 1e-9)
                    if is_zero.mean() > 0.5:
                        # Create rolling aggregate (3-bar cluster)
                        agg_name = f"{col}_roll3_sum"
                        transformed_data[agg_name] = data[col].rolling(3).sum()
                        new_feature_names.append(agg_name)

            # === ENHANCEMENT 6: Explicit Trigger-Context Interactions ===
            # Cross 'Flow' triggers with 'Vol' contexts
            # Use binned MI as a cheap proxy to pre-select informative features
            triggers = [c for c in transformed_data.columns if 'flow' in c or 'pressure' in c]
            contexts = [c for c in transformed_data.columns if 'regime' in c or 'volatility' in c]
            
            # Filter out already-crossed features
            triggers = [t for t in triggers if '_x_' not in t]
            contexts = [c for c in contexts if '_x_' not in c]
            
            # Smart pre-selection: rank by binned MI with target (close returns)
            # Top 33% keeps the most informative while cutting total by 9x
            def compute_binned_mi(feature_col, target_col, n_bins=10):
                """Cheap MI proxy using quantile binning."""
                try:
                    from sklearn.metrics import mutual_info_score
                    feat = pd.qcut(feature_col.rank(method='first'), q=n_bins, labels=False, duplicates='drop')
                    tgt = pd.qcut(target_col.rank(method='first'), q=n_bins, labels=False, duplicates='drop')
                    valid = feat.notna() & tgt.notna()
                    if valid.sum() < 100:
                        return 0.0
                    return mutual_info_score(feat[valid], tgt[valid])
                except Exception:
                    return 0.0
            
            # Use close returns as target proxy
            target_proxy = data['close'].pct_change().fillna(0) if 'close' in data.columns else pd.Series(0, index=data.index)
            
            # Rank triggers and contexts by MI, keep top 33%
            if len(triggers) > 3:
                trigger_mi = {t: compute_binned_mi(transformed_data[t], target_proxy) for t in triggers if t in transformed_data.columns}
                n_keep = max(3, len(triggers) // 3)
                triggers = sorted(trigger_mi.keys(), key=lambda x: trigger_mi[x], reverse=True)[:n_keep]
            if len(contexts) > 3:
                context_mi = {c: compute_binned_mi(transformed_data[c], target_proxy) for c in contexts if c in transformed_data.columns}
                n_keep = max(3, len(contexts) // 3)
                contexts = sorted(context_mi.keys(), key=lambda x: context_mi[x], reverse=True)[:n_keep]
            
            for trig in triggers:
                for ctx in contexts:
                    if trig != ctx:
                        name = f"{trig}_x_{ctx}"
                        if name not in transformed_data.columns:
                            transformed_data[name] = transformed_data[trig] * transformed_data[ctx]
                            new_feature_names.append(name)

            n_before_dedup = len(new_feature_names)
            
            # === FILTER 4: Correlation Deduplication ===
            if len(new_feature_names) > 0 and correlation_threshold < 1.0:
                try:
                    # Sample for speed
                    sample_size = min(2000, len(transformed_data))
                    sample_df = transformed_data[new_feature_names].tail(sample_size).dropna(axis=1)
                    
                    if not sample_df.empty and sample_df.shape[1] > 1:
                        # Vectorized correlation calculation
                        corr_matrix = sample_df.corr().abs()
                        
                        # Find indices exceeding threshold
                        upper = corr_matrix.where(np.triu(np.ones(corr_matrix.shape), k=1).astype(bool))
                        features_to_drop = [column for column in upper.columns if any(upper[column] > correlation_threshold)]
                        
                        # Drop redundant features
                        if features_to_drop:
                            transformed_data = transformed_data.drop(columns=features_to_drop, errors='ignore')
                            if self.verbose:
                                tprint_info(f"   🔄 Correlation dedup: removed {len(features_to_drop)} redundant features")
                except Exception as e:
                    if self.verbose:
                        tprint_warning(f"   ⚠️ Correlation dedup failed: {e}")
            
            if self.verbose:
                n_final = len(transformed_data.columns) - len(data.columns)
                tprint_success(f"✅ Smart causal transformation: {n_final} new features")
                tprint_info(f"   - Before dedup: {n_before_dedup}, After dedup: {n_final}")
            
            return transformed_data
            
        except Exception as e:
            if self.verbose:
                tprint_error(f"❌ Causal feature transformation failed: {e}")
            return data

    def create_heterogeneity_features(
        self,
        X: pd.DataFrame,
        treatment: Union[pd.Series, np.ndarray, str],
        context_patterns: Optional[List[str]] = None
    ) -> pd.DataFrame:
        """
        Create interaction features between treatment/signal and context variables.
        Used for ORF to explicitly detect Heterogeneous Treatment Effects (HTE).
        
        Args:
            X: Feature matrix containing context variables
            treatment: Treatment signal (Series, array, or column name in X)
            context_patterns: List of string patterns to identify context features in X
            
        Returns:
            DataFrame containing original X plus new interaction features
        """
        try:
            if self.verbose:
                tprint_info("⚡ Creating Heterogeneity Features (Signal x Context)...")
                
            X_out = X.copy()
            
            # 1. Get Treatment Series
            if isinstance(treatment, str):
                if treatment in X.columns:
                    t_series = X[treatment]
                else:
                    tprint_warning(f"   ⚠️ Treatment column '{treatment}' not found in X")
                    return X
            elif isinstance(treatment, (pd.Series, np.ndarray)):
                t_series = pd.Series(treatment, index=X.index) if isinstance(treatment, np.ndarray) else treatment
            else:
                return X
                
            # 2. Identify Context Features
            if context_patterns is None:
                context_patterns = ['regime', 'volatility', 'trend', 'volume', 'liquidity', 'pressure']
                
            context_cols = []
            for col in X.columns:
                # Skip if col is the treatment itself
                if isinstance(treatment, str) and col == treatment:
                    continue
                    
                # Check if matches any pattern
                if any(pat in col.lower() for pat in context_patterns):
                    context_cols.append(col)
                    
            if not context_cols:
                if self.verbose:
                    tprint_warning("   ⚠️ No context features found matching patterns")
                return X
                
            # 3. Create Interactions
            new_features = {}
            for ctx in context_cols:
                name = f"HTE_signal_x_{ctx}"
                new_features[name] = t_series * X[ctx]
                
            # Add all at once for performance
            if new_features:
                new_df = pd.DataFrame(new_features, index=X.index)
                X_out = pd.concat([X_out, new_df], axis=1)
                
            if self.verbose:
                tprint_success(f"✅ Added {len(new_features)} heterogeneity interactions")
                
            return X_out
            
        except Exception as e:
            if self.verbose:
                tprint_error(f"❌ Heterogeneity feature creation failed: {e}")
            return X

    
    def apply_causal_engineering(
        self,
        data: pd.DataFrame,
        apply_denoising: bool = True,
        apply_adjustment: bool = True,
        apply_imputation: bool = True,
        apply_transformation: bool = True
    ) -> Tuple[pd.DataFrame, Dict[str, Any]]:
        """
        Apply complete causal engineering pipeline.
        
        Args:
            data: Input data
            apply_denoising: Whether to apply causal denoising
            apply_adjustment: Whether to apply causal adjustment
            apply_imputation: Whether to apply causal imputation
            apply_transformation: Whether to apply feature transformation
            
        Returns:
            Tuple of (engineered_data, metadata)
        """
        try:
            if self.verbose:
                tprint_info("🚀 Starting Causal Feature Engineering Pipeline...")
            
            engineered_data = data.copy()
            metadata = {
                'original_features': list(data.columns),
                'applied_steps': [],
                'feature_counts': {
                    'original': len(data.columns),
                    'final': len(data.columns),
                    'added': 0
                },
                'causal_models_count': 0
            }
            
            # Step 1: Learn causal relationships
            if not self.causal_models_:
                causal_models = self.learn_causal_relationships(data)
                metadata['causal_models_count'] = len(causal_models)
                metadata['applied_steps'].append('causal_relationship_learning')
            
            # Step 2: Causal imputation (if needed)
            if apply_imputation and data.isnull().sum().sum() > 0:
                engineered_data = self.causal_imputation(engineered_data)
                metadata['applied_steps'].append('causal_imputation')
            
            # Step 3: Causal denoising
            if apply_denoising:
                engineered_data = self.causal_denoise(engineered_data)
                metadata['applied_steps'].append('causal_denoising')
            
            # Step 4: Causal adjustment
            if apply_adjustment:
                engineered_data = self.causal_adjustment(engineered_data)
                metadata['applied_steps'].append('causal_adjustment')
            
            # Step 5: Feature transformation
            if apply_transformation:
                engineered_data = self.causal_feature_transformation(engineered_data)
                metadata['applied_steps'].append('causal_transformation')
            
            # Compile metadata
            metadata['final_features'] = list(engineered_data.columns)
            metadata['feature_counts'] = {
                'original': len(data.columns),
                'final': len(engineered_data.columns),
                'added': len(engineered_data.columns) - len(data.columns)
            }
            metadata['causal_adjustments'] = self.causal_adjustments_
            
            if self.verbose:
                tprint_success("✅ Causal Feature Engineering Complete:")
                tprint_info(f"   - Original features: {metadata['feature_counts']['original']}")
                tprint_info(f"   - Final features: {metadata['feature_counts']['final']}")
                tprint_info(f"   - Added features: {metadata['feature_counts']['added']}")
                tprint_info(f"   - Applied steps: {', '.join(metadata['applied_steps'])}")
            
            return engineered_data, metadata
            
        except Exception as e:
            if self.verbose:
                tprint_error(f"❌ Causal feature engineering failed: {e}")
            return data, {'error': str(e)}
    
    def get_causal_summary(self) -> Dict[str, Any]:
        """
        Get summary of causal engineering results.
        
        Returns:
            Summary dictionary
        """
        return {
            'causal_models_count': len(self.causal_models_),
            'causal_adjustments_count': len(self.causal_adjustments_),
            'denoising_method': self.denoising_method,
            'imputation_method': self.imputation_method,
            'has_causal_graph': self.causal_graph is not None,
            'variable_names': self.variable_names
        }

# Convenience functions
def quick_causal_engineering(
    data: pd.DataFrame,
    causal_graph: Optional[Dict[str, List[str]]] = None,
    **kwargs
) -> Tuple[pd.DataFrame, Dict[str, Any]]:
    """
    Quick causal engineering with default parameters.
    
    Args:
        data: Input data
        causal_graph: Causal graph
        **kwargs: Additional parameters
        
    Returns:
        Tuple of (engineered_data, metadata)
    """
    engineer = CausalFeatureEngineering(causal_graph=causal_graph, **kwargs)
    return engineer.apply_causal_engineering(data)

def causal_denoise_only(data: pd.DataFrame, **kwargs) -> pd.DataFrame:
    """
    Apply only causal denoising.
    
    Args:
        data: Input data
        **kwargs: Additional parameters
        
    Returns:
        Denoised data
    """
    engineer = CausalFeatureEngineering(**kwargs)
    return engineer.causal_denoise(data)

def causal_adjustment_only(data: pd.DataFrame, **kwargs) -> pd.DataFrame:
    """
    Apply only causal adjustment.
    
    Args:
        data: Input data
        **kwargs: Additional parameters
        
    Returns:
        Adjusted data
    """
    engineer = CausalFeatureEngineering(**kwargs)
    return engineer.causal_adjustment(data)
