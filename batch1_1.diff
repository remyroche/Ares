+                return 0.5
+
+            if verbose:
+                logger.info("[DIVERSITY_SWEEP] Finding optimal colsample_bytree...")
+
+            # Use a sample for faster sweep if dataset is large
+            sweep_sample_size = min(5000, len(X))
+            if len(X) > sweep_sample_size:
