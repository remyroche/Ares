+def _mad(x):
+    x = np.asarray(x, dtype=float)
+    x = x[np.isfinite(x)]
+    if x.size == 0:
+        return 0.0
+    med = np.median(x)
+    return float(np.median(np.abs(x - med)) + 1e-12)
+
+
+def _safe_spearman(x, y):
+    try:
+        v = spearmanr(x, y).correlation
+        return float(v) if np.isfinite(v) else 0.0
+    except Exception:
+        return 0.0
+
