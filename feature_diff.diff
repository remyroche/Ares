+        dy = y_ranks[i] - mean_y
+        num += dx * dy
+        den_x += dx * dx
+        den_y += dy * dy
+
+    if den_x < 1e-12 or den_y < 1e-12:
+        return 0.0
+
+    return num / np.sqrt(den_x * den_y)
