STORAGE_PREFIX=dev

MUSIC_PROVIDER=dummy
IMAGE_PROVIDER=dummy
YOUTUBE_ENABLED=false
TIKTOK_ENABLED=false
INSTAGRAM_ENABLED=false

CMS_PROVIDER=dummy
