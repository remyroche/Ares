{
  "optimization_settings": {
    "n_trials": 150,
    "timeout": 3600,
    "study_name": "hmm_regime_optimization",
    "random_state": 42
  },
  "hmm_parameters": {
    "n_components_range": [2, 10],
    "covariance_types": ["full", "tied", "diag", "spherical"],
    "n_iter_range": [50, 300],
    "tol_range": [1e-6, 1e-2],
    "reg_covar_range": [1e-7, 1e-2]
  },
  "clustering_parameters": {
    "methods": ["kmeans", "gaussian_mixture"],
    "n_clusters_range": [3, 15],
    "kmeans_init_methods": ["k-means++", "random"],
    "kmeans_n_init_range": [5, 25],
    "kmeans_max_iter_range": [200, 600],
    "gmm_covariance_types": ["full", "tied", "diag", "spherical"],
    "gmm_init_params": ["kmeans", "random"],
    "gmm_max_iter_range": [100, 400]
  },
  "feature_engineering_parameters": {
    "use_pca_options": [true, false],
    "n_pca_components_range": [5, 25],
    "feature_selection_methods": ["all", "variance", "correlation"],
    "correlation_threshold_range": [0.7, 0.98],
    "variance_threshold_range": [0.005, 0.15],
    "scaling_methods": ["standard", "robust", "minmax"]
  },
  "evaluation_weights": {
    "market_differentiation": 0.4,
    "cluster_quality": 0.2,
    "market_consistency": 0.2,
    "cluster_balance": 0.1,
    "market_separation": 0.1
  },
  "market_condition_keywords": [
    "volatility", "momentum", "volume", "returns", "price_change",
    "trend", "regime", "market", "condition", "state",
    "rsi", "macd", "bollinger", "atr", "adx", "stoch", "cci"
  ],
  "output_settings": {
    "save_visualizations": true,
    "save_reports": true,
    "save_models": false,
    "output_format": "json"
  }
}