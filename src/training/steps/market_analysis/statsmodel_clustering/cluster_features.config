# Statsmodel Clustering Feature Configuration
# This configuration file defines what features are used for statsmodel clustering
# Features are selected from the feature bank and transformed appropriately

[general]
# General configuration
config_version = 1.0
last_updated = 2024-01-01
description = Feature configuration for statsmodel Markov-switching clustering

[feature_categories]
# Feature categories to include from the feature bank
# Available categories: volatility, volume, microstructure, order_flow, cross_timeframe, trend, momentum
enabled_categories = volatility,volume,microstructure,order_flow,cross_timeframe,trend,momentum

[normalization]
# Normalization strategy
# Options: RobustScaler, StandardScaler, MinMaxScaler, RankPercentile
default_scaler = RobustScaler
volatile_features_scaler = RankPercentile

# Volatile features that should use rank percentile normalization
volatile_features = volatility,volume,extreme_returns,price_range,volume_spike

[multi_timeframe]
# Multi-timeframe feature generation
enabled = true
timeframes = 1h,4h

# How to aggregate multi-timeframe features
# Options: concat (concatenate features), ratio (create ratios), both
aggregation_method = both

[rolling_windows]
# Rolling window configurations (in bars)
# These windows will be used for rolling statistics and features
windows = 24,72

# Whether to include window-specific features
include_window_stats = true

# Statistics to calculate for each window
# Options: mean, std, min, max, median, skew, kurt
window_stats = mean,std,min,max

[pca]
# PCA dimensionality reduction
enabled = true
n_components = 12

# PCA variance threshold (alternative to n_components)
# If specified, will use this instead of n_components
# variance_threshold = 0.95

# Whether to scale features before PCA
scale_before_pca = true

# Scaler to use before PCA
pca_scaler = StandardScaler

[features.volatility]
# Volatility features from feature bank
# Based on src/feature_generation/categories/volatility.py
features = realized_volatility,garman_klass_volatility,parkinson_volatility,rogers_satchell_volatility,yang_zhang_volatility,close_to_close_volatility,bollinger_band_width,atr,normalized_atr,volatility_ratio

# Lookback periods for volatility features (if applicable)
lookback_periods = 20,50,100

[features.volume]
# Volume features from feature bank
# Based on src/feature_generation/categories/volume.py
features = volume_sma,volume_ema,volume_std,relative_volume,volume_rate_of_change,on_balance_volume,volume_price_trend,money_flow_index,force_index,ease_of_movement

# Lookback periods for volume features
lookback_periods = 20,50

[features.microstructure]
# Microstructure features (order book, spread, etc.)
# Based on src/feature_generation/categories/order_flow.py or similar
features = bid_ask_spread,effective_spread,price_impact,order_imbalance,trade_imbalance,vpin

# Note: Some microstructure features may require order book data

[features.order_flow]
# Order flow features
# Based on src/feature_generation/categories/order_flow.py
features = buy_sell_ratio,aggressive_trade_ratio,order_flow_imbalance,cumulative_delta,net_volume

[features.cross_timeframe]
# Cross-timeframe correlation and regime features
# Based on src/feature_generation/categories/regime_feature_integration.py
features = cross_timeframe_corr,regime_persistence_score,price_volume_sync,regime_sync_strength

# Timeframe pairs for correlation calculation
timeframe_pairs = 1h_4h,4h_1d

[features.trend]
# Trend features from feature bank
# Based on src/feature_generation/categories/trend.py
features = sma,ema,dema,tema,wma,ema_slope,trend_strength,adx,di_plus,di_minus,aroon_up,aroon_down,supertrend

# Lookback periods for trend features
lookback_periods = 20,50,100,200

[features.momentum]
# Momentum features from feature bank
# Based on src/feature_generation/categories/momentum.py
features = rsi,stoch_k,stoch_d,macd,macd_signal,macd_histogram,roc,momentum,trix,cci,williams_r,ultimate_oscillator

# Lookback periods for momentum features
lookback_periods = 14,20,50

[features.regime]
# Regime-specific features from regime_feature_integration.py and regime_feature_categorization.py
# These are essential for clustering
features = regime_persistence,vol_regime_strength,vol_clustering,vol_regime_change,volume_regime_strength,volume_clustering,statistical_persistence,distribution_stability

# Intermediate volatility features (12, 26, 72 windows)
intermediate_volatility_windows = 12,26,72

# Lagged features (windowed features for past 3-5 bars)
lagged_windows = 3,4,5

# Derived features (ratios, normalized indicators, trend strength)
derived_features = price_zscore,price_to_ma_ratio,returns_cv,trend_strength_ratio,volatility_ratio

# Temporal awareness features (differences, momentum indicators)
temporal_features = temporal_price_diff,temporal_price_acceleration,momentum_3,momentum_5,momentum_10

[execution_modes]
# Data periods for different execution modes
# blank: minimal data for testing
# light: reduced data for faster execution
# full: complete data as defined by ares_launcher

blank_days = 20
light_days = 180

# Whether to cache features for each mode
cache_features = true

[advanced]
# Advanced configuration options

# Minimum samples required for feature calculation
min_samples = 100

# Whether to drop NaN values after feature generation
drop_nan = true

# Whether to drop constant features (features with zero variance)
drop_constant = true

# Correlation threshold for removing highly correlated features
# If two features have correlation > threshold, one will be dropped
correlation_threshold = 0.95

# Whether to apply feature selection before PCA
feature_selection_enabled = false

# Feature selection method (if enabled)
# Options: mutual_info, f_regression, rfe, lasso
feature_selection_method = mutual_info

# Number of features to select (if feature selection enabled)
n_features_to_select = 50

# Whether to use regime-specific feature categorization
use_regime_categorization = true

# Regime use case for feature selection
# Options: HDBSCAN_CLUSTERING, REGIME_CLUSTERING, REGIME_MODELS_TRAINING, REGIME_ENSEMBLE_TRAINING
regime_use_case = REGIME_CLUSTERING

[quality_control]
# Quality control for generated features

# Maximum percentage of NaN values allowed in a feature
max_nan_percentage = 0.1

# Maximum percentage of infinite values allowed in a feature
max_inf_percentage = 0.01

# Whether to validate feature distributions
validate_distributions = true

# Whether to log feature statistics
log_feature_stats = true

# Whether to save feature importance (if available)
save_feature_importance = true
