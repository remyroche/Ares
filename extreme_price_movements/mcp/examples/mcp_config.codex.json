{
  "mcpServers": {
    "quant-advisor": {
      "command": "node",
      "args": ["/absolute/path/to/extreme_price_movements/mcp/dist/index.js"],
      "env": {
        "QUANT_PROVIDER": "codex",
        "OPENAI_API_KEY": "sk-...",
        "OPENAI_BASE_URL": "https://api.openai.com/v1",
        "OPENAI_CLASSIFIER_MODEL": "gpt-5-mini",
        "OPENAI_ADVISOR_MODEL": "gpt-5.3-codex",
        "MAX_PARALLEL_ADVISORS": "3",
        "MAX_RETRIES": "2",
        "REQUEST_TIMEOUT_MS": "20000",
        "CLASSIFIER_TIMEOUT_MS": "8000",
        "DEBUG": "1"
      }
    }
  }
}
