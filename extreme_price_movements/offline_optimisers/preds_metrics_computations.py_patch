import pandas as pd
import numpy as np
import os

def resolve_15m_ambiguity(df: pd.DataFrame, fwd_ret: np.ndarray, tp: float, sl: float, side_int: int = 1) -> np.ndarray:
    # If df does not have 'ts' and 'asset', we can't do anything
    if 'ts' not in df.columns or 'asset' not in df.columns:
        return fwd_ret

    resolved_ret = fwd_ret.copy()

    # We group by asset to load 15m data once per asset
    for asset, asset_df in df.groupby('asset'):
        # Check if 15m data exists
        path_pq = f"extreme_price_movements/15m_ohlcv/{asset}.parquet"
        path_csv = f"extreme_price_movements/15m_ohlcv/{asset}.csv"

        df_15 = None
        if os.path.exists(path_pq):
            df_15 = pd.read_parquet(path_pq)
        elif os.path.exists(path_csv):
            df_15 = pd.read_csv(path_csv)
            if 'timestamp' in df_15.columns:
                df_15['timestamp'] = pd.to_datetime(df_15['timestamp'], utc=True)
                df_15.set_index('timestamp', inplace=True)
            elif 'ts' in df_15.columns:
                df_15['ts'] = pd.to_datetime(df_15['ts'], utc=True)
                df_15.set_index('ts', inplace=True)

        if df_15 is None or df_15.empty:
            continue

        if not pd.api.types.is_datetime64_any_dtype(df_15.index):
            df_15.index = pd.to_datetime(df_15.index, utc=True)

        df_15 = df_15.sort_index()

        # Now iterate over the asset's rows in df
        for idx in asset_df.index:
            row_ts = asset_df.loc[idx, 'ts']
            if not pd.notnull(row_ts):
                continue

            row_ts = pd.to_datetime(row_ts, utc=True)
            # Find the 15m bars inside this 1h bar (from row_ts to row_ts + 1h)
            start_ts = row_ts
            end_ts = row_ts + pd.Timedelta(hours=1)

            mask = (df_15.index >= start_ts) & (df_15.index < end_ts)
            bars = df_15.loc[mask]

            if bars.empty:
                continue

            entry_p = bars.iloc[0]['open'] # proxy entry
            # or should we use close of prev? We just need to check TP/SL hits relative to entry_p.
            # but wait, tp and sl are relative returns.
            # Actually, `apply_tpsl_proxy` uses `fwd_ret`. `fwd_ret` is just the horizon return.
            # We don't have entry_p! Wait! We can assume entry_p = 1.0, and convert bars to relative returns!
            entry_p = bars.iloc[0]['open']
            if entry_p <= 0: continue

            if side_int == 1:
                sl_price = entry_p * (1.0 - sl)
                tp_price = entry_p * (1.0 + tp)
            else:
                sl_price = entry_p * (1.0 + sl)
                tp_price = entry_p * (1.0 - tp)

            # Iterate through the 15m bars to find the first hit
            hit_tp = False
            hit_sl = False

            for _, bar in bars.iterrows():
                hh = bar['high']
                ll = bar['low']
                cc = bar['close']

                bar_hit_tp = False
                bar_hit_sl = False

                if side_int == 1:
                    if ll <= sl_price: bar_hit_sl = True
                    if hh >= tp_price: bar_hit_tp = True
                else:
                    if hh >= sl_price: bar_hit_sl = True
                    if ll <= tp_price: bar_hit_tp = True

                if bar_hit_tp and not bar_hit_sl:
                    resolved_ret[idx] = tp
                    break
                elif bar_hit_sl and not bar_hit_tp:
                    resolved_ret[idx] = -sl
                    break
                elif bar_hit_sl and bar_hit_tp:
                    # Ambiguity on the same 15m bar
                    d_tp = abs(cc - tp_price)
                    d_sl = abs(cc - sl_price)
                    if d_tp < d_sl:
                        resolved_ret[idx] = tp
                    else:
                        resolved_ret[idx] = -sl
                    break

    return resolved_ret
