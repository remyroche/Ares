modules = ["nodejs-20", "web", "bash", "python-3.11"]
[agent]
expertMode = true

[nix]
channel = "stable-25_05"
packages = ["glibcLocales"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Ares Info"

[[workflows.workflow]]
name = "Ares Info"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python3 src/launcher/ares_launcher.py list-steps"

[workflows.workflow.metadata]
outputType = "console"
