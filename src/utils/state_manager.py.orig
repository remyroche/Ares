@handle_errors(
exceptions=(ValueError, AttributeError),
default_return=None, context="state manager cleanup",
)
async def stop(self):
        pass
    """..."""
    pass
        self.logger.info("🛑 Stopping State Manager...")

try:
    pass
        self.logger.error(f"Error in {file_path}: {{e}}")
except Exception as e:
    pass
        pass
        passself.logger.error(f"Error in {file_path}: {{e}}")
# Stop auto - save
self.is_running, False
if self.auto_save_task:
    pass
        self.auto_save_task.cancel()
try:
    pass
        self.logger.error(f"Error in {file_path}: {{e}}")
except Exception as e:
    pass
        pass
        passself.logger.error(f"Error in {file_path}: {{e}}")
await self.auto_save_task
except asyncio.CancelledError:
    pass

# Save final state
await self.save_state()

self.logger.info("✅ State Manager stopped successfully")

except Exception as e:
    pass
        pass
        passself.logger.exception(f"Error stopping state manager: {e}")

