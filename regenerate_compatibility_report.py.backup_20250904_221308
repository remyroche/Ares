#!/usr/bin/env python3
"""
Regenerate the compatibility analysis report with the improved signature analyzer.
This script will create a new, more accurate compatibility analysis report.
"""

import json
import os
from pathlib import Path
from code_quality.analyzers.signature_analyzer import SignatureAnalyzer
from code_quality.core.config import CodeQualityConfig

def regenerate_compatibility_report():
    """Regenerate the compatibility analysis report with improved analyzer."""
    print("🔄 Regenerating compatibility analysis report with improved analyzer...")
    
    # Create config
    config = CodeQualityConfig()
    
    # Create analyzer
    analyzer = SignatureAnalyzer(config)
    
    # Get all Python files in the project
    python_files = []
    for root, dirs, files in os.walk("."):
        # Skip certain directories
        dirs[:] = [d for d in dirs if d not in [".git", "__pycache__", "node_modules", "venv", "env", "backup_", "mlruns", "artifacts", "checkpoints", "logs", "log"]]
        
        for file in files:
            if file.endswith(".py"):
                python_files.append(os.path.join(root, file))
    
    print(f"📁 Found {len(python_files)} Python files to analyze")
    
    # Run analysis
    results = analyzer.analyze_files(python_files)
    
    # Create the new report structure
    new_report = {
        "summary": {
            "total_compatibility_issues": results["summary"]["compatibility_issues"],
            "total_missing_functions": results["summary"]["missing_functions"],
            "total_signature_changes": results["summary"]["signature_changes"],
            "total_unused_functions": results["summary"]["unused_functions"],
            "total_issues": results["summary"]["total_issues"],
            "files_analyzed": len(python_files),
            "analysis_timestamp": results.get("timestamp", "unknown")
        },
        "compatibility_issues_by_category": {
            "missing_arguments": [],
            "too_many_arguments": [],
            "unknown_keyword_arguments": []
        },
        "missing_functions_by_category": {
            "collections_dataclasses": [],
            "other": []
        },
        "unused_functions": results.get("unused_functions", []),
        "signature_changes": results.get("signature_changes", []),
        "analysis_improvements": {
            "decorator_calls_skipped": "Improved analyzer now skips decorator calls like @handle_errors",
            "import_calls_skipped": "Improved analyzer now skips import-related calls",
            "method_calls_skipped": "Improved analyzer now skips method calls on objects",
            "default_parameters_handled": "Improved analyzer now correctly handles default parameters",
            "generic_names_skipped": "Improved analyzer now skips generic function names like 'func', 'callback'",
            "short_names_skipped": "Improved analyzer now skips very short function names (likely variables)"
        }
    }
    
    # Categorize compatibility issues
    for issue in results.get("compatibility_issues", []):
        message = issue.get("message", "")
        if "Missing required arguments" in message:
            new_report["compatibility_issues_by_category"]["missing_arguments"].append(issue)
        elif "Too many positional arguments" in message:
            new_report["compatibility_issues_by_category"]["too_many_arguments"].append(issue)
        elif "Unknown keyword argument" in message:
            new_report["compatibility_issues_by_category"]["unknown_keyword_arguments"].append(issue)
    
    # Categorize missing functions
    for issue in results.get("missing_functions", []):
        function_name = issue.get("function_name", "")
        if function_name in ["defaultdict", "asdict", "field"]:
            new_report["missing_functions_by_category"]["collections_dataclasses"].append(issue)
        else:
            new_report["missing_functions_by_category"]["other"].append(issue)
    
    # Save the new report
    output_path = "code_quality/reports/compatibility_issues_analysis_improved.json"
    os.makedirs(os.path.dirname(output_path), exist_ok=True)
    
    with open(output_path, "w", encoding="utf-8") as f:
        json.dump(new_report, f, indent=2)
    
    print(f"✅ New compatibility analysis report saved to: {output_path}")
    print(f"📊 Summary:")
    print(f"   - Compatibility issues: {new_report['summary']['total_compatibility_issues']}")
    print(f"   - Missing functions: {new_report['summary']['total_missing_functions']}")
    print(f"   - Unused functions: {new_report['summary']['total_unused_functions']}")
    print(f"   - Signature changes: {new_report['summary']['total_signature_changes']}")
    print(f"   - Total issues: {new_report['summary']['total_issues']}")
    
    return new_report

if __name__ == "__main__":
    regenerate_compatibility_report()
